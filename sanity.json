{
  "root": true,
  "project": {
    "name": "Living Pupil Homeschool"
  },
  "api": {
    "projectId": "fu27fy1m",
    "dataset": "production"
  },
  "plugins": [
    "@sanity/base",
    "@sanity/default-layout",
    "@sanity/default-login",
    "@sanity/desk-tool"
  ],
  "env": {
